POSTGRES_PASSWORD=replace-with-a-long-random-password

# SeaweedFS / S3-compatible object storage
S3_ROOT_USER=bloodfox
S3_ROOT_PASSWORD=replace-with-a-different-long-random-password
S3_ADMIN_TOKEN=replace-with-a-long-random-admin-token
S3_BUCKET=bloodfox-assets
S3_PUBLIC_ENDPOINT=http://localhost:8333

# Set true only when the site is served over HTTPS. Keep false for local http://localhost.
SESSION_COOKIE_SECURE=false
